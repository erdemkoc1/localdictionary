# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.ico binary
*.zip binary
*.exe binary
